local floor = preview.part({ Name = "Floor", Size = Vector3.new(200, 1, 200), Position = Vector3.new(0, -0.5, 0), Parent = store })

local function boxHit(part, origin, direction)
	-- A ray against a part's box, which here is never turned.
	local half = part.Size / 2
	local center = part.Position
	local near, far = -math.huge, math.huge
	local normal = Vector3.new(0, 0, 0)
	for _, axis in { "X", "Y", "Z" } do
		local o, d = origin[axis] - center[axis], direction[axis]
		if math.abs(d) < 1e-9 then
			if math.abs(o) > half[axis] then
				return nil
			end
		else
			local t1, t2 = (-half[axis] - o) / d, (half[axis] - o) / d
			local sign = -1
			if t1 > t2 then
				t1, t2 = t2, t1
				sign = 1
			end
			if t1 > near then
				near = t1
				normal = Vector3.new(if axis == "X" then sign else 0, if axis == "Y" then sign else 0, if axis == "Z" then sign else 0)
			end
			far = math.min(far, t2)
		end
	end
	if near > far or near < 0 then
		return nil
	end
	return near, normal
end

local parts = { back, carton, cap, floor }
preview.geometry({
	raycast = function(origin, direction, params)
		local length = direction.Magnitude
		local unit = direction.Unit
		local skipped = {}
		for _, s in params and params.FilterDescendantsInstances or {} do
			skipped[s] = true
		end
		local best, bestT, bestNormal = nil, math.huge, nil
		for _, part in parts do
			if not skipped[part] then
				local t, normal = boxHit(part, origin, unit)
				if t and t < bestT and t <= length then
					best, bestT, bestNormal = part, t, normal
				end
			end
		end
		if not best then
			return nil
		end
		return { Instance = best, Position = origin + unit * bestT, Normal = bestNormal, Distance = bestT, Material = Enum.Material.Plastic }
	end,
})

-- ------------------------------------------------------------------ a fake hub

local Hub = { requests = {}, notes = {}, nextId = 1, run = nil, desks = 1 }
local function view(note)
	note.number = note.ordinal
	note.readiness = if note.recording then "recording" elseif note.sent then "sent" elseif (note.text or "") ~= "" then "ready" else "markOnly"
	return note
end
local function answer(method, path, body)
	table.insert(Hub.requests, { method = method, path = path, body = body })
	if path == "/v1/roblox" then
		return { id = "place", title = "Place" }
	end
	local rest = string.match(path, "^/v1/projects/place(.*)$")
	if rest == "/marks" and method == "GET" then
		local list = {}
		for _, note in Hub.notes do
			table.insert(list, view(note))
		end
		return { notes = list, snapshots = {}, desks = Hub.desks }
	end
	if rest == "/marks" and method == "POST" then
		local note = { id = "note" .. Hub.nextId, ordinal = Hub.nextId, shape = body.shape, world = body.world, target = body.target, text = "", recording = if body.voice and Hub.desks > 0 then "recording" else nil }
		Hub.nextId += 1
		table.insert(Hub.notes, note)
		local out = table.clone(view(note))
		out.picture = true
		out.desks = Hub.desks
		return out
	end
	if rest == "/marks/send" then
		for _, note in Hub.notes do
			note.sent = true
		end
		Hub.run = { status = "running", agent = "Claude Code", activity = { "Editing game/src/server/StoreBuilder.luau" } }
		return Hub.run
	end
	if rest == "/run" then
		return Hub.run or {}
	end
	local id = string.match(rest or "", "^/marks/([%w]+)$")
	if id then
		for i, note in Hub.notes do
			if note.id == id then
				if body and body.discard then
					table.remove(Hub.notes, i)
					return { discarded = true }
				end
				if body and body.stop then
					note.recording = nil
					note.text = note.live or note.text
				end
				if body and body.text then
					note.text = body.text
					note.recording = nil
				end
				if body and body.depth and note.target then
					note.target.depth = body.depth
				end
				return view(note)
			end
		end
	end
	return { error = "nothing here: " .. tostring(path) }
end

local fakeHttp = setmetatable({
	RequestAsync = function(_, options)
		local path = string.gsub(options.Url, "^http://127%.0%.0%.1:8799", "")
		local body = options.Body and HttpServiceReal:JSONDecode(options.Body) or nil
		local reply = answer(options.Method, path, body)
		return { Success = reply.error == nil, StatusCode = if reply.error then 404 else 200, StatusMessage = reply.error or "OK", Body = HttpServiceReal:JSONEncode(reply) }
	end,
	JSONEncode = function(_, v)
		return HttpServiceReal:JSONEncode(v)
	end,
	JSONDecode = function(_, v)
		return HttpServiceReal:JSONDecode(v)
	end,
}, { __index = HttpServiceReal })

-- In Edit mode, as in Studio before pressing Play: no client-server bridge.
