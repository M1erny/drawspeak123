	GetMouseLocation = function()
		return mouse
	end,
	GetFocusedTextBox = function()
		return nil
	end,
	IsKeyDown = function()
		return shifted
	end,
}, { __index = UserInputServiceReal })

local services = {
	HttpService = fakeHttp,
	RunService = fakeRun,
	UserInputService = fakeInput,
	-- Studio's CoreGui, here where the simulator draws from.
	CoreGui = Players.LocalPlayer:WaitForChild("PlayerGui"),
}
local fakeGame = setmetatable({
	GetService = function(_, name)
		return services[name] or realGame:GetService(name)
	end,
	FindFirstChild = function(_, name)
		return realGame:FindFirstChild(name)
	end,
}, { __index = realGame })

local fakePlugin = {
	CreateToolbar = function()
		return {
			CreateButton = function()
				return { Click = { Connect = function() end }, ClickableWhenViewportHidden = false }
			end,
		}
	end,
	Unloading = { Connect = function() end },
}

-- ------------------------------------------------------------------ the plugin's own code

local function loadCore()
	--[[CORE]]
end
local CoreModule = loadCore()
local function loadScene()
	local script = { Parent = { Core = "Core" } }
	local game = fakeGame
	local require = function()
		return CoreModule
	end
	--[[SCENE]]
end
local SceneModule = loadScene()
-- The simulator has no physics to ask: the parts within reach, by their boxes.
SceneModule.partsNear = function(point, radius)
	local out = {}
	for _, part in parts do
		if (part.Position - point).Magnitude - part.Size.Magnitude / 2 <= radius then
			table.insert(out, part)
		end
	end
	return out
end
local function runPlugin()
	local script = { Core = "Core", Scene = "Scene" }
	local game = fakeGame
	local plugin = fakePlugin
	local require = function(name)
		return if name == "Core" then CoreModule else SceneModule
	end
	--[[MAIN]]
end
runPlugin()

-- ------------------------------------------------------------------ playing it

advance(0.2)
local gui = services.CoreGui:FindFirstChild("Drawspeak3D")
step("the plugin boots and draws its palette", gui ~= nil and gui:FindFirstChild("Palette") ~= nil)
step("it asks the hub for its project", Hub.requests[1] and Hub.requests[1].path == "/v1/roblox")

local function key(name, began)
	P.fireEvent(UserInputServiceReal, if began then "InputBegan" else "InputEnded", P.inputObject({ KeyCode = Enum.KeyCode[name], UserInputType = Enum.UserInputType.Keyboard }), false)
	P.pump()
end
local function mouseEvent(event, kind, at)
	mouse = at
	P.fireEvent(UserInputServiceReal, event, P.inputObject({ UserInputType = kind, Position = Vector3.new(at.X, at.Y, 0), KeyCode = Enum.KeyCode.Unknown }), false)
	P.pump()
end

key("X", true)
local catcher = gui:FindFirstChild("Catcher")
step("X arms it: the catcher takes the mouse", catcher.Visible == true)

-- A circle around the carton, in the middle of the view.
local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
local radius = viewport.Y * 0.2
local function around(i, n)
	local a = i / n * math.pi * 2
	return center + Vector2.new(math.cos(a) * radius, math.sin(a) * radius)
end
mouse = around(0, 40)
P.fireEvent(catcher, "InputBegan", P.inputObject({ UserInputType = Enum.UserInputType.MouseButton1, Position = Vector3.new(mouse.X, mouse.Y, 0), KeyCode = Enum.KeyCode.Unknown }), false)
for i = 1, 40 do
	mouseEvent("InputChanged", Enum.UserInputType.MouseMovement, around(i, 40))
end
step("ink follows the mouse", #gui:FindFirstChild("Ink"):GetChildren() > 40)
mouseEvent("InputEnded", Enum.UserInputType.MouseButton1, around(40, 40))
key("X", false)
advance(0.3)

local posted
for _, r in Hub.requests do
	if r.method == "POST" and string.match(r.path, "/marks$") then
		posted = r.body
	end
end
step("the mark reaches the hub", posted ~= nil)
step("a closed circle is a lasso", posted.shape.kind == "lasso", posted.shape.kind)
local chain = posted.target.layers[1]
local names = {}
for _, entity in chain do
	table.insert(names, entity.label)
end
print("chain: " .. table.concat(names, " > "), "depth " .. tostring(posted.target.depth))
step("the thing circled is the Milk model, not the rack behind it", chain[posted.target.depth + 1].label == "Milk", table.concat(names, ","))
step("its parents follow", table.find(names, "Rack3") ~= nil and table.find(names, "Store") ~= nil)
step("it names the Instance by its full path", string.find(chain[posted.target.depth + 1].locator.value, "Store.Rack3.Milk", 1, true) ~= nil, chain[posted.target.depth + 1].locator.value)
step("attributes go along", chain[posted.target.depth + 1].data and chain[posted.target.depth + 1].data.ProductId == "jush:1001")
step("the rack is offered as what lies behind", posted.target.layers[2] ~= nil)
step("the camera goes along", posted.pose.fov == 70 and #posted.pose.quaternion == 4)
local a = posted.world.anchor
step("the ink lies on the carton's front, in the world", math.abs(a[3] - (-19)) < 0.01, a[3])
step("X let go: the catcher lets go", catcher.Visible == false)
step("the screen ink is gone once the mark is saved", #gui:FindFirstChild("Ink"):GetChildren() == 0)
step("the bubble opens", gui:FindFirstChild("Bubble").Visible == true)
local thingDepth = posted.target.depth
