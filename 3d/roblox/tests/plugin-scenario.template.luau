-- The real plugin, run inside swing-shop's Roblox simulator (tools/ui-preview), with a fake hub and a
-- small made-up world. It checks what can be checked without Studio: that the plugin boots, that every
-- property it sets exists, that a stroke picks the right Instance and reaches the hub, and how it looks.
-- Generated by roblox/preview.mjs, which fills in the sources and the ending below.
local P = __PREVIEW
local realGame = game
local Players = realGame:GetService("Players")
local HttpServiceReal = realGame:GetService("HttpService")
local RunServiceReal = realGame:GetService("RunService")
local UserInputServiceReal = realGame:GetService("UserInputService")

local function step(name, ok, detail)
	assert(ok, "step failed: " .. name .. (if detail ~= nil then " (" .. tostring(detail) .. ")" else ""))
	print("STEP ok   " .. name)
end

